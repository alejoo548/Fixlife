# Frontend Dockerfile
FROM node:20-alpine

# Directorio de trabajo
WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependencias
RUN npm ci

# Copiar código
COPY . .

# Exponer puerto
EXPOSE 3000

# Comando por defecto (dev mode)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
