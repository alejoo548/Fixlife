# Frontend Dockerfile
FROM node:20-alpine

# Working directory
WORKDIR /app

# Install dependencies first for better layer caching
COPY package*.json ./
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000 \
    && npm ci --no-audit --no-fund

# Copy project files and build once
COPY . .

# Build-time variables used by Vite (injected from docker-compose build args)
ARG VITE_API_URL
ARG VITE_ENABLE_GOOGLE_LOGIN
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_RECAPTCHA_SITE_KEY
ARG VITE_TOMTOM_TRAFFIC_KEY
ARG VITE_VIRTUAL_WALLET_CLIENT_ID
ARG VITE_VIRTUAL_WALLET_SCRIPT_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ENABLE_GOOGLE_LOGIN=$VITE_ENABLE_GOOGLE_LOGIN
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY
ENV VITE_TOMTOM_TRAFFIC_KEY=$VITE_TOMTOM_TRAFFIC_KEY
ENV VITE_VIRTUAL_WALLET_CLIENT_ID=$VITE_VIRTUAL_WALLET_CLIENT_ID
ENV VITE_VIRTUAL_WALLET_SCRIPT_URL=$VITE_VIRTUAL_WALLET_SCRIPT_URL

RUN npm run build

EXPOSE 3000

# Serve a stable built app (no Vite watcher/HMR)
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
