fixlife.site, www.fixlife.site {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		reverse_proxy backend:8000
	}

	handle /socket.io/* {
		reverse_proxy backend:8000 {
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
