# Copy this file to .env and update with your private values.

# App mode
NODE_ENV=development
PORT=8000

# MySQL / Docker
MYSQL_ROOT_PASSWORD=change_me_use_a_long_random_password
MYSQL_DATABASE=fixlife_db
MYSQL_USER=fixlife_user
MYSQL_PASSWORD=change_me_use_a_long_random_password

# MySQL backups (dedicated low-privilege user, must differ from MYSQL_ROOT_PASSWORD)
BACKUP_DB_PASSWORD=change_me_use_a_long_random_password
BACKUP_RETENTION_DAYS=14

# Backend database connection
# DB_USER is a dedicated low-privilege app user (created by docker/mysql-init.sh),
# not root — a compromised backend can't take over the whole MySQL server.
DB_HOST=mysql
DB_PORT=3306
DB_USER=fixlife_app
DB_PASSWORD=change_me_use_a_long_random_password
DB_NAME=fixlife_db
DB_SSL=true

# Self-hosted OSRM routing (docker-compose "osrm" service). Leave as-is unless
# you're running the backend outside docker-compose or pointing at a different
# OSRM instance (e.g. https://router.project-osrm.org for the public demo).
OSRM_BASE_URL=http://osrm:5000

# Web Push (real push notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fixlife.site

DB_MIGRATIONS_MODE=auto
ENABLE_RUNTIME_SCHEMA_SYNC=false

# Local URLs
VITE_API_URL=http://127.0.0.1:8000/api
FRONTEND_ORIGIN=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000
PUBLIC_APP_URL=http://127.0.0.1:3000
PUBLIC_API_ORIGIN=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# JWT Secret
JWT_SECRET=change_me_use_at_least_32_random_bytes

# Email Configuration
EMAIL_USER=
EMAIL_PASS=

# Google OAuth / reCAPTCHA
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
VITE_ENABLE_GOOGLE_LOGIN=false
VITE_GOOGLE_CLIENT_ID=
VITE_RECAPTCHA_SITE_KEY=

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PLATFORM_FEE_RATE=0.12

# Wompi (El Salvador). The dashboard's own "Redirect URL"/"Url webhook" fields
# (panel.wompi.sv > Enlaces y botones de pago) are NOT used by this integration —
# both are sent per-request in the EnlacePago API call instead.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
WOMPI_TOKEN_URL=https://id.wompi.sv/connect/token
WOMPI_API_URL=https://api.wompi.sv

# Virtual Wallet (LAN sandbox only; their widget requires the secret key on the
# client <script> tag, so it's intentionally duplicated into VITE_ here too)
VIRTUAL_WALLET_CLIENT_ID=
VIRTUAL_WALLET_SECRET_KEY=
VIRTUAL_WALLET_SCRIPT_URL=
VITE_VIRTUAL_WALLET_CLIENT_ID=
VITE_VIRTUAL_WALLET_SECRET_KEY=
VITE_VIRTUAL_WALLET_SCRIPT_URL=

# Optional frontend services
VITE_TOMTOM_TRAFFIC_KEY=
